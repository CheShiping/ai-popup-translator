{
    "build":  {
                  "frontendDist":  "../dist",
                  "beforeBuildCommand":  "npm run build",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "npm run dev"
              },
    "version":  "1.0.0",
    "bundle":  {
                   "copyright":  "Copyright (c) 2026 CheShiping",
                   "icon": [],
                   "targets": "all",
                   "active":  true,
                   "shortDescription":  "AI Popup Translator",
                   "category":  "DeveloperTool"
               },
    "plugins":  {

                },
    "app":  {
                "windows":  [
                                {
                                    "decorations":  false,
                                    "alwaysOnTop":  true,
                                    "width":  800,
                                    "visible":  false,
                                    "title":  "AI Translator",
                                    "center":  true,
                                    "height":  600,
                                    "skipTaskbar":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src \u0027self\u0027 https://dashscope.aliyuncs.com https://api.openai.com"
                             }
            },
    "identifier":  "com.cheshiping.ai-popup-translator",
    "productName":  "AI Translator"
}